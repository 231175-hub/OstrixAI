{
  "hosting": {
    "site": "ostrixai",
    "public": "frontend/ostrixai-web/dist/ostrixai-web/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
