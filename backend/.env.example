MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ostrix_app
MYSQL_PASSWORD=
# Required only when initializing the disposable Docker database.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=ostrixai
# For AWS RDS: use a trusted CA bundle and set MYSQL_SSL_CA=/path/to/global-bundle.pem
CORS_ORIGINS=http://localhost:4200
FIREBASE_PROJECT_ID=REPLACE_WITH_PROJECT_ID
# Use workload identity in production, or GOOGLE_APPLICATION_CREDENTIALS to a local gitignored service-account JSON.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path/firebase-service-account.json
